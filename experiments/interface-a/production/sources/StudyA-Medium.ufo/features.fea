languagesystem DFLT dflt;
languagesystem latn dflt;
feature zero { sub zero by zero.slash; sub zero.tab by zero.slash.tab; } zero;
feature tnum {
 sub zero by zero.tab;
 sub one by one.tab;
 sub two by two.tab;
 sub three by three.tab;
 sub four by four.tab;
 sub five by five.tab;
 sub six by six.tab;
 sub seven by seven.tab;
 sub eight by eight.tab;
 sub nine by nine.tab;
 sub zero.slash by zero.slash.tab;
} tnum;

feature locl {
 script latn;
 language CAT;
 sub l periodcentered' l by periodcentered.loclCAT;
 sub L periodcentered' L by periodcentered.loclCAT.case;
 language TRK; sub i by idotaccent;
 language AZE; sub i by idotaccent;
 language CRT; sub i by idotaccent;
 language KAZ; sub i by idotaccent;
 language TAT; sub i by idotaccent;
} locl;
@StudyAbove = [gravecomb acutecomb uni0302 tildecomb uni0304 uni0306 uni0307 uni0308 uni030A uni030B uni030C];
feature ccmp { lookup StudySoftDots { lookupflag UseMarkFilteringSet @StudyAbove; sub i' @StudyAbove by dotlessi; sub j' @StudyAbove by uni0237; sub iogonek' @StudyAbove by iogonek.dotless; } StudySoftDots; } ccmp;
